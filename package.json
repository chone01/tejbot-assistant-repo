{
  "name": "tejbot-assistent",
  "productName": "Tejbot Assistent",
  "version": "1.0.0",
  "description": "Tejbot Assistent - pomocník pro streamery: klipy z OBS, ovládání OBS a widget s hudbou",
  "author": "Tejren Productions",
  "homepage": "https://tejbot.eu/stahnout",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "obs-websocket-js": "^5.0.6"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "eu.tejbot.assistent",
    "productName": "Tejbot Assistent",
    "files": ["src/**", "assets/**"],
    "asarUnpack": ["src/media-win.ps1"],
    "publish": { "provider": "github", "owner": "chone01", "repo": "tejbot-assistant-repo" },
    "win": { "target": "nsis", "icon": "assets/icon.ico", "artifactName": "Tejbot-Assistent-Setup.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "Tejbot Assistent"
    },
    "linux": { "target": "AppImage", "icon": "assets/icon.png", "category": "AudioVideo", "artifactName": "Tejbot-Assistent.${ext}" }
  }
}
